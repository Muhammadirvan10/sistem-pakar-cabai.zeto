# CabaiCare Environment Variables

# API Configuration
# Di Vercel, jika frontend dan api dalam 1 domain, kosongkan atau gunakan '' atau URL Vercel
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Supabase Database & Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Computer Vision AI Inference Service (Optional / Eksternal Endpoint)
AI_INFERENCE_URL=https://api.cabaicare-ai.example.com/v1/predict
AI_API_KEY=your-ai-api-key
AI_MODEL_VERSION=v1.0.0-resnet50-chili

# Admin Credentials & Security (Hash / Salted)
ADMIN_USERNAME=admin@cabaicare.id
ADMIN_PASSWORD=AdminCabaiCare2026!
JWT_SECRET=cabaicare-super-secret-jwt-key-32chars-min!

